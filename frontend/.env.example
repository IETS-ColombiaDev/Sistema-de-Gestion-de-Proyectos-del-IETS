# Backend: "local" (IndexedDB, sin dependencias externas) o "firebase"
VITE_BACKEND=local

# Dominio institucional permitido para Google Sign-In
VITE_ALLOWED_DOMAIN=iets.org.co

# Credenciales Firebase (solo cuando VITE_BACKEND=firebase).
# Nunca se versionan: se toman del gestor de secretos del entorno.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
