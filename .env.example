# =============================================================================
# HIGEP Web — Variables de Entorno (Plantilla de Referencia)
# =============================================================================
# Copie este archivo como "frontend/.env" para configurar su entorno:
#   cp .env.example frontend/.env
#
# Backend: "local" (IndexedDB sin dependencias externas) o "firebase" (produccion)
VITE_BACKEND=local

# Dominio institucional permitido para inicio de sesion con Google
VITE_ALLOWED_DOMAIN=iets.org.co

# Credenciales Firebase (requeridas UNICAMENTE cuando VITE_BACKEND=firebase)
# Nunca se versionan: provienen del gestor de secretos de la plataforma.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
